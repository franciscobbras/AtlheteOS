# Phase-1 validation: point the locally-served function at the REMOTE project,
# so it reads the real Vault secrets and writes to the real wearable.* tables.
# Copy to `.env` (same directory) and fill in, then serve with:
#   supabase functions serve ingest-wearable --env-file supabase/functions/ingest-wearable/.env --no-verify-jwt
#
# When DEPLOYED, Supabase injects SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# automatically — this file is only for local `serve`.

SUPABASE_URL=https://owdabspslxibnyybtcxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
